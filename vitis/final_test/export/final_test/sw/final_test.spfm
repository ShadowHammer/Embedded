<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="final_test"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
final_test
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="final_test">
        <sdx:configuration sdx:name="final_test"
                           sdx:displayName="final_test"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>final_test</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="final_test/boot/final_test.bif"
                            sdx:readme="final_test/boot/generic.readme"
                            sdx:qemuArguments="final_test/qemu/pmu_args.txt:final_test/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="final_test/boot/final_test.bif"
                            sdx:readme="final_test/boot/generic.readme"
                            sdx:qemuArguments="final_test/standalone_domain/qemu/pmu_args.txt:final_test/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone on psu_cortexa53_0"
                                sdx:cpuType="cortex-a53"
                                sdx:cpuInstance="psu_cortexa53_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="final_test/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="final_test/standalone_domain/bspinclude/include"
                        sdx:bspConfig="final_test/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
